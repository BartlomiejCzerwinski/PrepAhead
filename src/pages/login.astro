---
import Layout from '../layouts/Layout.astro';
import { safeAuthRedirectPath } from '../lib/server/auth-redirect';

export const prerender = false;

const nextRaw = Astro.url.searchParams.get('next');
const sanitizedNext = nextRaw ? safeAuthRedirectPath(nextRaw) : null;
const nextHidden =
  sanitizedNext && sanitizedNext !== '/app' ? sanitizedNext : null;
const errorCode = Astro.url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  configuration: 'Sign-in is not configured yet. Check environment variables.',
  session: 'Your session could not be verified. Please sign in again.',
  sign_in_failed: 'Could not start sign-in. Please try again.',
  provider_denied: 'Sign-in was cancelled or denied.',
  missing_code: 'Sign-in did not complete. Please try again.',
  exchange_failed: 'Could not finish sign-in. Please try again.',
};

const errorMessage = errorCode ? (errorMessages[errorCode] ?? 'Something went wrong. Please try again.') : null;
---

<Layout title="Sign in" description="Sign in to PrepAhead with Google to access practice sets tailored to your job description.">
	<main class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-8 sm:px-6">
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(99,102,241,0.16),transparent_34%),radial-gradient(circle_at_80%_18%,rgba(139,92,246,0.12),transparent_28%)]"
			aria-hidden="true"
		></div>

		<section class="relative w-full max-w-md">
			<div class="mb-8 flex justify-center">
				<a href="/" class="inline-flex items-center gap-3 text-[var(--text)] no-underline">
					<span
						class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-sm font-bold text-white shadow-sm"
						aria-hidden="true">P</span>
					<span class="text-base font-semibold tracking-tight">PrepAhead</span>
				</a>
			</div>

			<div class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface-elevated)] p-6 text-center shadow-[0_24px_80px_rgba(17,24,39,0.12)] dark:shadow-none sm:p-8">
				<h1 class="text-3xl font-bold tracking-tight text-[var(--text)]">Sign in</h1>
				<p class="mt-3 text-sm leading-6 text-[var(--text-muted)]">
					Continue to PrepAhead with your Google account.
				</p>

				{
					errorMessage && (
						<p class="mt-6 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-left text-sm leading-6 text-red-700 dark:text-red-300" role="alert">
							{errorMessage}
						</p>
					)
				}

				<form method="POST" action="/api/auth/sign-in" class="mt-8">
					{nextHidden && <input type="hidden" name="next" value={nextHidden} />}
					<button type="submit" class="btn-primary inline-flex w-full items-center justify-center gap-3 rounded-xl px-5 py-3 text-sm font-semibold shadow-sm">
						<span class="flex h-5 w-5 items-center justify-center rounded-full bg-white text-xs font-bold text-[#4285f4]" aria-hidden="true">G</span>
						Continue with Google
					</button>
				</form>

				<p class="mt-6 text-sm text-[var(--text-muted)]">
					<a href="/" class="font-medium text-[var(--brand)] no-underline hover:underline">Back to home</a>
				</p>
			</div>
		</section>
	</main>
</Layout>
