---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const next = Astro.url.searchParams.get('next');
const errorCode = Astro.url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  configuration: 'Sign-in is not configured yet. Check environment variables.',
  sign_in_failed: 'Could not start sign-in. Please try again.',
  provider_denied: 'Sign-in was cancelled or denied.',
  missing_code: 'Sign-in did not complete. Please try again.',
  exchange_failed: 'Could not finish sign-in. Please try again.',
};

const errorMessage = errorCode ? (errorMessages[errorCode] ?? 'Something went wrong. Please try again.') : null;
---

<Layout title="Sign in" description="Sign in to PrepAhead with Google to access practice sets tailored to your job description.">
	<main class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold tracking-tight text-[var(--text)]">Sign in</h1>
		<p class="mt-3 text-[var(--text-muted)]">
			Use Google to access practice sets tailored to your job description.
		</p>

		{
			errorMessage && (
				<p class="mt-6 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-300" role="alert">
					{errorMessage}
				</p>
			)
		}

		<form method="POST" action="/api/auth/sign-in" class="mt-8">
			{next && <input type="hidden" name="next" value={next} />}
			<button type="submit" class="btn-primary w-full rounded-xl px-6 py-3 text-sm font-semibold shadow-sm">
				Continue with Google
			</button>
		</form>

		<p class="mt-6 text-center text-sm">
			<a href="/" class="font-medium text-[var(--brand)] no-underline hover:underline">Back to home</a>
		</p>
	</main>
</Layout>
