---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPostLayout from '../../components/blog/BlogPostLayout.astro';
import OpenEndedPost from '../../components/blog/OpenEndedPost.astro';
import InteractiveQuizPost from '../../components/blog/InteractiveQuizPost.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const { title, description, pubDate, tags, type } = entry.data;
const canonicalPath = `/blog/${slug}`;
---

<Layout {title} {description} {canonicalPath}>
  <BlogPostLayout {title} {pubDate} {tags}>
    {type === 'open-ended' && <OpenEndedPost {entry} />}
    {type === 'interactive-quiz' && <InteractiveQuizPost {entry} />}
  </BlogPostLayout>
</Layout>
