---
import {
  getAbcdProgress,
  getOpenEndedProgress,
  parsePracticeSetWithProgress,
  PracticeSetContractError,
} from '../../../../lib/practice/contracts';
import { resolveInitialQuestionIndex } from '../../../../lib/practice/practice-set-navigation';
import { createSupabaseServerClient } from '../../../../lib/supabase/server';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const practiceSetId = typeof Astro.params.id === 'string' ? Astro.params.id.trim() : '';

if (!practiceSetId) {
  return Astro.redirect('/app');
}

const practiceUrl = `/app/sets/${practiceSetId}/practice`;
const overviewUrl = `/app/sets/${practiceSetId}`;
const queryQuestion = Astro.url.searchParams.get('q');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const { data: practiceSet, error: practiceSetError } = await supabase
  .from('practice_sets')
  .select('id, content')
  .eq('id', practiceSetId)
  .eq('user_id', user.id)
  .is('deleted_at', null)
  .maybeSingle();

if (practiceSetError || !practiceSet?.content) {
  return Astro.redirect(overviewUrl);
}

let redirectQuestion = queryQuestion;

if (!redirectQuestion) {
  try {
    const content = parsePracticeSetWithProgress(practiceSet.content);
    const abcdProgress = getAbcdProgress(content);
    const openEndedProgress = getOpenEndedProgress(content);
    const index = resolveInitialQuestionIndex({
      queryQuestion: null,
      abcdCurrentIndex: abcdProgress.currentIndex,
      abcdComplete: abcdProgress.isComplete,
      openEndedCurrentIndex: openEndedProgress.currentIndex,
    });
    redirectQuestion = String(index + 1);
  } catch (error) {
    if (!(error instanceof PracticeSetContractError)) {
      throw error;
    }
  }
}

const target = redirectQuestion ? `${practiceUrl}?q=${redirectQuestion}` : practiceUrl;

return Astro.redirect(target);
---
