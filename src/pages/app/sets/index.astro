---
import AppLayout from '../../../components/app/AppLayout.astro';
import PracticeSetCard from '../../../components/app/PracticeSetCard.astro';
import { listPracticeSetSummaries } from '../../../lib/practice/history';
import { createSupabaseServerClient } from '../../../lib/supabase/server';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const display =
  user.email ?? (user.id ? `${user.id.slice(0, 8)}…` : 'Signed in');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const result = await listPracticeSetSummaries(supabase, user.id);

const summaries = result.ok ? result.data : [];
const locale = Astro.request.headers.get('accept-language')?.split(',')[0]?.trim() ?? 'en';
---

<AppLayout
  title="Your practice sets"
  description="Browse and reopen the PrepAhead practice sets you've generated."
  userEmail={display}
>
  <section class="space-y-6">
    <div class="space-y-2">
      <a
        href="/app"
        class="inline-flex items-center text-sm font-medium text-[var(--brand)] no-underline hover:underline"
      >
        Back to dashboard
      </a>
      <h1 class="text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">
        Your practice sets
      </h1>
      <p class="text-sm leading-6 text-[var(--text-muted)]">
        Reopen any set to keep practicing or review your answers.
      </p>
    </div>

    {!result.ok ? (
      <div class="rounded-[1.75rem] border border-[var(--border)] bg-[var(--surface-elevated)] px-5 py-4 text-sm leading-6 text-[var(--text)]">
        <p class="font-semibold">We couldn't load your practice sets</p>
        <p class="mt-2 text-[var(--text-muted)]">
          Something went wrong on our side. Please refresh the page or try again in a moment.
        </p>
      </div>
    ) : summaries.length === 0 ? (
      <div class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface-elevated)] p-6 shadow-sm dark:shadow-none sm:p-8">
        <p class="text-sm leading-6 text-[var(--text-muted)]">
          You haven't generated any practice sets yet. Paste a job description to get a tailored
          set of questions.
        </p>
        <div class="mt-4">
          <a
            href="/app/generate"
            class="btn-primary inline-flex items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold shadow-sm no-underline"
          >
            Generate your first set
          </a>
        </div>
      </div>
    ) : (
      <ol class="space-y-4">
        {summaries.map((summary) => (
          <li>
            <PracticeSetCard summary={summary} locale={locale} />
          </li>
        ))}
      </ol>
    )}
  </section>
</AppLayout>
