---
import AppLayout from '../../components/app/AppLayout.astro';
import UsageDashboard from '../../components/app/UsageDashboard.astro';
import { getUsageSummary } from '../../lib/plan';
import { createSupabaseServerClient } from '../../lib/supabase/server';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const display =
  user.email ?? (user.id ? `${user.id.slice(0, 8)}…` : 'Signed in');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const usageResult = await getUsageSummary(supabase, user.id);
---

<AppLayout
  title="Dashboard"
  description="View your PrepAhead plan, remaining practice-set generations, and Check calls."
  userEmail={display}
>
  <UsageDashboard
    summary={usageResult.ok ? usageResult.data : undefined}
    error={!usageResult.ok}
  />

  <a
    href="/app/sets"
    class="mt-6 block rounded-[1.75rem] border border-[var(--border)] bg-[var(--surface-elevated)] px-5 py-4 no-underline shadow-sm transition hover:bg-[var(--surface-muted)] dark:shadow-none"
  >
    <p class="text-sm font-semibold text-[var(--brand)]">Your practice sets</p>
    <p class="mt-1 text-sm text-[var(--text-muted)]">
      View and reopen the practice sets you've already generated.
    </p>
  </a>
</AppLayout>
