---
import AppLayout from '../../components/app/AppLayout.astro';
import UsageDashboard from '../../components/app/UsageDashboard.astro';
import { getUsageSummary } from '../../lib/plan';
import { createSupabaseServerClient } from '../../lib/supabase/server';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const display =
  user.email ?? (user.id ? `${user.id.slice(0, 8)}…` : 'Signed in');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const usageResult = await getUsageSummary(supabase, user.id);
---

<AppLayout
  title="Dashboard"
  description="View your PrepAhead plan, remaining practice-set generations, and Check calls."
  userEmail={display}
>
  <UsageDashboard
    summary={usageResult.ok ? usageResult.data : undefined}
    error={!usageResult.ok}
  />
</AppLayout>
