---
import AppDashboard from '../../components/app/AppDashboard.astro';
import AppLayout from '../../components/app/AppLayout.astro';
import { getUsageSummary } from '../../lib/plan';
import { listPracticeSetSummaries } from '../../lib/practice/history';
import { createSupabaseServerClient } from '../../lib/supabase/server';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const display =
  user.email ?? (user.id ? `${user.id.slice(0, 8)}…` : 'Signed in');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [usageResult, practiceSetsResult] = await Promise.all([
  getUsageSummary(supabase, user.id),
  listPracticeSetSummaries(supabase, user.id),
]);
---

<AppLayout
  title="Dashboard"
  description="Your PrepAhead practice dashboard — resume sets, track progress, and generate new interview prep."
  userEmail={display}
>
  <AppDashboard
    summary={usageResult.ok ? usageResult.data : undefined}
    usageError={!usageResult.ok}
    practiceSets={practiceSetsResult.ok ? practiceSetsResult.data : []}
    practiceSetsError={!practiceSetsResult.ok}
  />
</AppLayout>
