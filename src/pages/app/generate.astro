---
import GeneratePracticeFlow from '../../components/app/GeneratePracticeFlow';
import AppLayout from '../../components/app/AppLayout.astro';
import { getUsageSummary } from '../../lib/plan';
import { createSupabaseServerClient } from '../../lib/supabase/server';

export const prerender = false;

const RECENT_SUCCEEDED_MS = 60 * 60 * 1000;
const RECENT_FAILED_MS = 24 * 60 * 60 * 1000;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const display =
  user.email ?? (user.id ? `${user.id.slice(0, 8)}…` : 'Signed in');

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const usageResult = await getUsageSummary(supabase, user.id);

const { data: latestJob } = await supabase
  .from('generation_jobs')
  .select('id, practice_set_id, status, failure_message, finished_at, created_at')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false })
  .limit(1)
  .maybeSingle();

let initialRecoveryState: {
  status: 'idle' | 'running' | 'failed' | 'ready';
  message?: string;
  jobId?: string;
  practiceSetId?: string;
} = { status: 'idle' };
let latestReadySetId: string | null = null;

if (latestJob) {
  const finishedAt =
    typeof latestJob.finished_at === 'string' ? new Date(latestJob.finished_at) : null;
  const createdAt =
    typeof latestJob.created_at === 'string' ? new Date(latestJob.created_at) : null;
  const finishedRecently =
    finishedAt instanceof Date &&
    !Number.isNaN(finishedAt.valueOf()) &&
    Date.now() - finishedAt.valueOf() <= RECENT_SUCCEEDED_MS;
  const failedRecently =
    createdAt instanceof Date &&
    !Number.isNaN(createdAt.valueOf()) &&
    Date.now() - createdAt.valueOf() <= RECENT_FAILED_MS;

  if (latestJob.status === 'queued' || latestJob.status === 'running') {
    initialRecoveryState = {
      status: 'running',
      jobId: latestJob.id,
      practiceSetId: latestJob.practice_set_id,
      message: 'Recovering your in-flight generation.',
    };
  } else if (latestJob.status === 'failed' && failedRecently) {
    initialRecoveryState = {
      status: 'failed',
      jobId: latestJob.id,
      practiceSetId: latestJob.practice_set_id,
      message: latestJob.failure_message ?? 'Generation failed. You can start a new request.',
    };
  } else if (latestJob.status === 'succeeded' && finishedRecently) {
    latestReadySetId = latestJob.practice_set_id;
  }
}
---

<AppLayout
  title="Generate practice set"
  description="Paste a job description, optionally add a PDF CV, and start a PrepAhead generation flow."
  userEmail={display}
>
  <GeneratePracticeFlow
    client:only="react"
    usageSummary={usageResult.ok ? usageResult.data : null}
    usageError={!usageResult.ok}
    initialRecoveryState={initialRecoveryState}
    latestReadySetId={latestReadySetId}
  >
    <div
      slot="fallback"
      class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface-elevated)] p-6 text-sm leading-6 text-[var(--text-muted)] shadow-sm dark:shadow-none sm:p-8"
    >
      Loading the generation form...
    </div>
  </GeneratePracticeFlow>
</AppLayout>
