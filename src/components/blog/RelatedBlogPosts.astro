---
import type { CollectionEntry } from 'astro:content';
import { BLOG_POST_TYPE_LABELS } from '../../lib/blog/post-types';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section
      class="quiz-related mt-16 border-t border-[var(--border)] pt-12"
      aria-labelledby="related-questions-heading"
    >
      <h2 id="related-questions-heading" class="!mt-0 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">
        Related interview questions
      </h2>
      <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-2">
        {posts.map((post) => (
          <li class="rounded-[1.25rem] border border-[var(--border)] bg-[var(--surface)] p-5 transition duration-200 ease-out hover:border-brand-500/30">
            <a href={`/blog/${post.id}`} class="block no-underline" style="text-decoration: none;">
              <span class="rounded-full border border-brand-500/15 bg-[var(--brand-soft)] px-2.5 py-1 text-xs font-semibold text-[var(--brand)]">
                {BLOG_POST_TYPE_LABELS[post.data.type]}
              </span>
              <h3 class="mt-3 text-base font-semibold text-[var(--text)]">{post.data.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--text-muted)]">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
