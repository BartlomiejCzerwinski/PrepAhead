---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<div class="blog-prose">
  <Content />
</div>
<p class="mt-8 rounded-xl border border-[var(--border)] bg-[var(--surface-muted)] px-4 py-3 text-sm text-[var(--text-muted)]">
  These prompts are for self-reflection here. Critical feedback on your answers is available in
  signed-in practice with Check—not on blog pages.
</p>
