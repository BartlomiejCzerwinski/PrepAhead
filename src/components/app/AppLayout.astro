---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../theme/ThemeToggle';

interface Props {
  title: string;
  description?: string;
  userEmail: string;
  /** Practice session shell: fills the viewport and locks page scroll. */
  fullWidth?: boolean;
  /** Wider content width for dashboard-style pages (not viewport-locked). */
  wide?: boolean;
}

const {
  title,
  description = 'Your PrepAhead practice workspace.',
  userEmail,
  fullWidth = false,
  wide = false,
} = Astro.props;

const headerMaxClass = fullWidth ? 'max-w-none py-3' : wide ? 'max-w-7xl py-3.5' : 'max-w-4xl py-4';
const mainClass = fullWidth
  ? 'min-h-0 w-full flex-1 overflow-hidden'
  : wide
    ? 'mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10'
    : 'mx-auto max-w-4xl px-4 py-10 sm:px-6';
---

<Layout title={title} description={description}>
  <div
    class:list={[
      'bg-[var(--background)]',
      fullWidth ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-screen',
    ]}
  >
    <header
      class:list={[
        'border-b border-[var(--border)] bg-[var(--surface-elevated)]/95',
        fullWidth ? '' : 'backdrop-blur-md',
      ]}
    >
      <div
        class:list={[
          'mx-auto flex items-center justify-between gap-4 px-4 sm:px-6',
          headerMaxClass,
          wide && !fullWidth ? 'lg:px-8' : '',
        ]}
      >
        <a href="/app" class="inline-flex items-center gap-2.5 text-[var(--text)] no-underline">
          <span
            class:list={[
              'flex items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-sm font-bold text-white shadow-sm',
              fullWidth ? 'h-8 w-8' : 'h-9 w-9',
            ]}
            aria-hidden="true">P</span>
          <span class="text-sm font-semibold tracking-tight sm:text-base">PrepAhead</span>
        </a>
        <div class="flex items-center gap-2.5 sm:gap-3">
          <span class="hidden max-w-[12rem] truncate text-sm text-[var(--text-muted)] sm:inline">
            {userEmail}
          </span>
          <ThemeToggle client:only="react">
            <div slot="fallback" class="h-8 w-[6rem]" aria-hidden="true"></div>
          </ThemeToggle>
          <form method="POST" action="/api/auth/sign-out">
            <button
              type="submit"
              class="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-sm font-semibold text-[var(--text)] transition hover:bg-[var(--surface-muted)]"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>
    </header>
    <main class={mainClass}>
      <slot />
    </main>
  </div>
</Layout>
