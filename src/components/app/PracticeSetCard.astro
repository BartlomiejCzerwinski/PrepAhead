---
import type { PracticeSetSummary } from '../../lib/practice/history';

interface Props {
  summary: PracticeSetSummary;
  locale?: string;
}

const { summary, locale = 'en' } = Astro.props;

const generatedLabel = new Intl.DateTimeFormat(locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
}).format(new Date(summary.createdAt));
---

<a
  href={`/app/sets/${summary.id}`}
  class="block rounded-[1.75rem] border border-[var(--border)] bg-[var(--surface-elevated)] px-5 py-4 no-underline shadow-sm transition hover:border-brand-500/30 hover:bg-[var(--surface-muted)] dark:shadow-none"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-base font-semibold text-[var(--text)]">{summary.title}</h2>
    <span
      class:list={[
        'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold',
        summary.statusLabel === 'completed'
          ? 'border-brand-500/20 bg-[var(--brand-soft)] text-[var(--brand)]'
          : 'border-[var(--border)] bg-[var(--surface-muted)] text-[var(--text-muted)]',
      ]}
    >
      {summary.statusLabel === 'completed' ? 'Completed' : 'In progress'}
    </span>
  </div>
  <p class="mt-1 text-sm text-[var(--text-muted)]">
    Generated {generatedLabel}
    {summary.hasCv ? ' · CV included' : ' · JD only'}
  </p>
  <p class="mt-2 text-sm text-[var(--text-muted)]">
    {
      summary.contentReady
        ? `${summary.abcdAnswered}/15 multiple-choice · ${summary.openEndedChecked}/5 checked${
            summary.abcdScorePercent !== null ? ` · ${summary.abcdScorePercent}% ABCD` : ''
          }`
        : 'Still preparing'
    }
  </p>
</a>
