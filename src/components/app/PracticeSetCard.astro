---
import type { PracticeSetSummary } from '../../lib/practice/history';

interface Props {
  summary: PracticeSetSummary;
  locale?: string;
}

const { summary, locale = 'en' } = Astro.props;

const generatedLabel = new Intl.DateTimeFormat(locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
}).format(new Date(summary.createdAt));

const abcdPercent = Math.round((summary.abcdAnswered / summary.abcdTotal) * 100);
const openEndedPercent = Math.round(
  (summary.openEndedChecked / summary.openEndedTotal) * 100,
);
const practiceHref = summary.contentReady
  ? `/app/sets/${summary.id}/practice`
  : `/app/sets/${summary.id}`;
---

<a
  href={practiceHref}
  class="group flex h-full flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface-elevated)] p-5 no-underline shadow-sm transition hover:border-brand-500/30 hover:bg-[var(--surface-muted)] dark:shadow-none"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-base font-semibold leading-snug text-[var(--text)] group-hover:text-[var(--brand)]">
      {summary.title}
    </h2>
    <span
      class:list={[
        'inline-flex shrink-0 items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold',
        summary.statusLabel === 'completed'
          ? 'border-brand-500/20 bg-[var(--brand-soft)] text-[var(--brand)]'
          : 'border-[var(--border)] bg-[var(--surface-muted)] text-[var(--text-muted)]',
      ]}
    >
      {summary.statusLabel === 'completed' ? 'Completed' : 'In progress'}
    </span>
  </div>

  <p class="mt-2 text-sm text-[var(--text-muted)]">
    Generated {generatedLabel}
    {summary.hasCv ? ' · CV included' : ' · JD only'}
  </p>

  {
    summary.contentReady ? (
      <div class="mt-4 space-y-3">
        <div>
          <div class="mb-1 flex justify-between text-xs text-[var(--text-muted)]">
            <span>Multiple choice</span>
            <span>
              {summary.abcdAnswered}/{summary.abcdTotal}
              {summary.abcdScorePercent !== null ? ` · ${summary.abcdScorePercent}%` : ''}
            </span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-muted)]">
            <div
              class="h-full rounded-full bg-[var(--brand)]"
              style={`width: ${abcdPercent}%`}
            />
          </div>
        </div>
        <div>
          <div class="mb-1 flex justify-between text-xs text-[var(--text-muted)]">
            <span>Open-ended</span>
            <span>
              {summary.openEndedChecked}/{summary.openEndedTotal} checked
            </span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-muted)]">
            <div
              class="h-full rounded-full bg-[var(--brand)]"
              style={`width: ${openEndedPercent}%`}
            />
          </div>
        </div>
      </div>
    ) : (
      <p class="mt-4 text-sm text-[var(--text-muted)]">Still preparing</p>
    )
  }

  <p class="mt-auto pt-4 text-sm font-semibold text-[var(--brand)]">
    {summary.statusLabel === 'completed' ? 'Review set' : 'Continue'} →
  </p>
</a>
