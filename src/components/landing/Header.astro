---
const nav = [
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#features', label: 'Features' },
	{ href: '#plans', label: 'Plans' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--surface-elevated)]/90 backdrop-blur-md">
	<div class="mx-auto flex h-[4.5rem] max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<a href="/" class="flex items-center gap-3 font-semibold tracking-tight text-[var(--text)] no-underline">
			<span
				class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-violet-500 text-sm font-bold text-white shadow-sm"
				aria-hidden="true">P</span>
			<span class="text-[15px] sm:text-base">PrepAhead</span>
		</a>
		<nav class="hidden items-center gap-7 md:flex" aria-label="Main">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="text-sm font-medium text-[var(--text-muted)] no-underline transition duration-200 ease-out hover:text-[var(--text)]"
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="flex items-center gap-3">
			<a
				href="#plans"
				class="hidden rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm font-medium text-[var(--text)] no-underline transition duration-200 ease-out hover:bg-[var(--surface-muted)] sm:inline-flex"
			>
				Pricing
			</a>
			<a
				href="#get-started"
				class="btn-primary inline-flex rounded-xl px-4 py-2 text-sm font-semibold shadow-sm"
			>
				Start free
			</a>
		</div>
	</div>
</header>
