---
const nav = [
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#features', label: 'Features' },
	{ href: '#plans', label: 'Plans' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--surface-elevated)]/90 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-[var(--text)] no-underline">
			<span
				class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white dark:bg-teal-500 dark:text-stone-900"
				aria-hidden="true">P</span>
			<span>PrepAhead</span>
		</a>
		<nav class="hidden items-center gap-6 sm:flex" aria-label="Main">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="text-sm font-medium text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text)]"
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<a
			href="#get-started"
			class="rounded-lg bg-[var(--brand)] px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-[var(--brand-hover)] dark:text-stone-900"
		>
			Get started
		</a>
	</div>
</header>
