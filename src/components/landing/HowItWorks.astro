---
const steps = [
	{
		step: '1',
		title: 'Paste the job description',
		body: 'Copy the posting from the careers page or job board—the same role you are preparing for.',
	},
	{
		step: '2',
		title: 'Generate your practice set',
		body: 'Get roughly twenty questions: about fifteen multiple-choice and five open-ended (architecture and behavioral), grounded in that JD.',
	},
	{
		step: '3',
		title: 'Drill and check',
		body: 'Answer ABCD items with instant explanations. Use Check on open-ended answers for critical feedback, then review your score summary.',
	},
];
---

<section id="how-it-works" class="border-b border-[var(--border)] bg-[var(--surface-elevated)] py-20 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">How it works</h2>
		<p class="mt-3 max-w-2xl text-lg text-[var(--text-muted)]">
			Three steps from job posting to a completed practice session.
		</p>
		<ol class="mt-12 grid gap-8 sm:grid-cols-3">
			{
				steps.map((item) => (
					<li class="relative rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6">
						<span
							class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700 dark:bg-teal-950 dark:text-teal-300"
							aria-hidden="true"
						>
							{item.step}
						</span>
						<h3 class="text-xl font-semibold text-[var(--text)]">{item.title}</h3>
						<p class="mt-2 text-[var(--text-muted)] leading-relaxed">{item.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
