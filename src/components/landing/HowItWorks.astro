---
const steps = [
	{
		step: '1',
		title: 'Paste the job description',
		body: 'Copy the posting from the careers page or job board—the same role you are preparing for.',
	},
	{
		step: '2',
		title: 'Generate your practice set',
		body: 'Get roughly twenty questions: about fifteen multiple-choice and five open-ended (architecture and behavioral), grounded in that JD.',
	},
	{
		step: '3',
		title: 'Drill and check',
		body: 'Answer ABCD items with instant explanations. Use Check on open-ended answers for critical feedback, then review your score summary.',
	},
];
---

<section id="how-it-works" class="border-b border-[var(--border)] bg-[var(--surface-elevated)] py-20 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center">
			<div>
				<div class="inline-flex rounded-full border border-brand-500/15 bg-[var(--brand-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--brand)]">
					How it works
				</div>
				<h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">
					Three steps from job posting to focused practice
				</h2>
				<p class="mt-4 max-w-2xl text-lg leading-8 text-[var(--text-muted)]">
					PrepAhead keeps the workflow simple: bring the role, generate a tailored session, then
					use feedback to sharpen weak spots before the interview.
				</p>
				<ol class="mt-10 space-y-4">
					{
						steps.map((item) => (
							<li class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 shadow-sm dark:shadow-none">
								<div class="flex gap-4">
									<span
										class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--brand-soft)] text-sm font-bold text-[var(--brand)]"
										aria-hidden="true"
									>
										{item.step}
									</span>
									<div>
										<h3 class="text-lg font-semibold text-[var(--text)]">{item.title}</h3>
										<p class="mt-2 leading-7 text-[var(--text-muted)]">{item.body}</p>
									</div>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<div class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface)] p-5 shadow-[0_16px_50px_rgba(17,24,39,0.08)] dark:shadow-none sm:p-6">
				<div class="flex items-center justify-between gap-4 border-b border-[var(--border)] pb-5">
					<div>
						<p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-soft)]">Interview flow</p>
						<h3 class="mt-2 text-xl font-semibold text-[var(--text)]">Technical Deep Dive</h3>
					</div>
					<span class="rounded-full bg-[var(--brand-soft)] px-3 py-1 text-xs font-semibold text-[var(--brand)]">
						Question 2 of 4
					</span>
				</div>
				<div class="mt-6">
					<div class="h-2 rounded-full bg-black/5 dark:bg-white/10">
						<div class="h-2 w-1/2 rounded-full bg-gradient-to-r from-brand-500 to-violet-500"></div>
					</div>
					<p class="mt-6 text-xl font-semibold leading-8 text-[var(--text)]">
						How would you design a scalable real-time chat application?
					</p>
					<p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">
						Explain the architecture, key components, and technologies you would use. PrepAhead
						then checks the depth, trade-offs, and clarity of your answer.
					</p>
					<div class="mt-6 min-h-[220px] rounded-[1.5rem] border border-[var(--border)] bg-[var(--surface-muted)] p-5 text-sm leading-7 text-[var(--text-soft)]">
						Write your answer here...
					</div>
					<div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
						<div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-muted)] p-4">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-soft)]">Tip</p>
							<p class="mt-2 max-w-sm text-sm leading-6 text-[var(--text-muted)]">
								Consider scalability, message delivery guarantees, data storage, and horizontal scaling.
							</p>
						</div>
						<a
							href="#get-started"
							class="btn-primary inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold shadow-sm"
						>
							Get feedback
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
