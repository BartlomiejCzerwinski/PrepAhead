---
const plans = [
	{
		name: 'FREE',
		price: '$0',
		period: 'per month',
		highlight: false,
		items: ['1 practice-set generation', '5 Checks per usage period', 'Upgrade when you need more'],
	},
	{
		name: 'PRO',
		price: 'Generous usage',
		period: 'fair-use limits shown in app',
		highlight: true,
		items: [
			'High monthly generation allowance with clear caps',
			'500 Check calls per month',
			'Limits visible—no “unlimited” surprise',
		],
	},
];
---

<section id="plans" class="border-y border-[var(--border)] bg-[var(--surface-elevated)] py-20 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="mx-auto max-w-3xl text-center">
			<div class="inline-flex rounded-full border border-brand-500/15 bg-[var(--brand-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--brand)]">
				Pricing
			</div>
			<h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">Simple plans for steady interview prep</h2>
			<p class="mt-4 text-lg leading-8 text-[var(--text-muted)]">
				Start free and upgrade only when you need more practice sessions and more feedback cycles.
			</p>
		</div>
		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{
				plans.map((plan) => (
					<article
						class:list={[
							'relative overflow-hidden rounded-[1.75rem] border p-8',
							plan.highlight
								? 'border-brand-500/40 bg-[var(--surface)] shadow-[0_16px_50px_rgba(99,102,241,0.12)] ring-1 ring-brand-500/20 dark:shadow-none'
								: 'border-[var(--border)] bg-[var(--surface)] shadow-sm dark:shadow-none',
						]}
					>
						{
							plan.highlight && (
								<div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-500 to-violet-500"></div>
							)
						}
						<h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--text-muted)]">
							{plan.name}
						</h3>
						<p class="mt-4 text-3xl font-bold text-[var(--text)]">{plan.price}</p>
						<p class="mt-2 text-sm text-[var(--text-muted)]">{plan.period}</p>
						<ul class="mt-8 space-y-4">
							{plan.items.map((item) => (
								<li class="flex gap-3 text-[var(--text-muted)]">
									<span
										class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-[var(--brand-soft)] text-xs font-bold text-[var(--brand)]"
										aria-hidden="true">✓</span
									>
									<span>{item}</span>
								</li>
							))}
						</ul>
						<a
							href="#get-started"
							class:list={[
								'mt-8 inline-flex w-full items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold no-underline transition duration-200 ease-out',
								plan.highlight
									? 'btn-primary shadow-sm'
									: 'border border-[var(--border)] bg-[var(--surface)] text-[var(--text)] hover:bg-[var(--surface-muted)]',
							]}
						>
							{plan.highlight ? 'Choose Pro' : 'Start free'}
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
