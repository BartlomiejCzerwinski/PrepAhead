# PrepAhead.dev environment template
#
# Copy this file to `.env.local` for local development.
# Never commit real secrets; set Production + Preview env vars in Vercel.
#
# Naming convention:
# - `PUBLIC_` variables may be exposed to client code (only put non-secret values here).
# - Non-`PUBLIC_` variables are server-only.
#
# Public (client-safe)
# PUBLIC_SITE_URL must match the browser origin used for OAuth (local preview, Vercel Preview, production).
# Local dev example: http://localhost:4321
# Vercel Preview: set Preview-scoped PUBLIC_SITE_URL to the preview deployment URL, or use VERCEL_URL runtime fallback (see deploy-plan).
PUBLIC_SITE_URL=
# Supabase project URL and anon key (Dashboard → Project Settings → API).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth is configured in the Supabase Dashboard (Authentication → Providers), not in this file.
# Supabase Auth → URL Configuration → Redirect URLs must include:
#   ${PUBLIC_SITE_URL}/api/auth/callback
#   https://prepahead.dev/api/auth/callback (production)
#   http://localhost:4321/api/auth/callback (local, adjust port if needed)
#   https://*.vercel.app/** (Vercel Preview wildcard) unless using a per-preview allowlist

# Server-only (never expose to client)
# service_role secret from Supabase Dashboard → Project Settings → API (NOT the anon/public key).
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Stripe: create a $9/mo Payment Link in Dashboard (Price on the link); use test keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=

# E2E (Playwright — local only; optional overrides)
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://localhost:4333
# PLAYWRIGHT_PORT=4333

