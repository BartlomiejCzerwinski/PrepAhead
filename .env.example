# PrepAhead.dev environment template
#
# Copy this file to `.env.local` for local development.
# Never commit real secrets; set Production + Preview env vars in Vercel.
#
# Naming convention:
# - `PUBLIC_` variables may be exposed to client code (only put non-secret values here).
# - Non-`PUBLIC_` variables are server-only.
#
# Public (client-safe)
PUBLIC_SITE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

